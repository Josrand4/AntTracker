<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme. -->
    <style name="Base.Theme.AnTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales - mantenemos el verde corporativo -->
        <item name="colorPrimary">#4CAF50</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">#1A4CAF50</item>
        <item name="colorOnPrimaryContainer">#4CAF50</item>
        
        <!-- Colores de superficie para modo oscuro -->
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        
        <!-- Colores de outline -->
        <item name="colorOutline">#938F99</item>
        <item name="colorOutlineVariant">#49454F</item>
        
        <!-- Colores de fondo -->
        <item name="android:colorBackground">#141218</item>
        <item name="colorOnBackground">#E6E1E5</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">#1C1B1F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>